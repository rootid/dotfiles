# zshrc workflow -
# Never pollute the ~/.zshrc
# 1. Create the directory for the function and aliases to /tools dir
# 2. Source the functions and aliases here
# 3. Run make link_tools
# Always put the config files in the package directory

# Sourcing aliases
ROOT_DIR=~

# Source a tool file only when it is readable, so one missing link (or a
# git-crypt locked file) cannot break shell startup. Missing files are
# reported once, at the end, instead of dumping an error per line.
typeset -ga MISSING_SH_WORKFLOW_FILES=()
go_sh_workflow_source() {
  if [[ -r "$1" ]]; then
    source "$1"
  else
    MISSING_SH_WORKFLOW_FILES+=("$1")
  fi
}

# zshrc
go_sh_workflow_source $ROOT_DIR/zsh/aliases.sh

# Brew
go_sh_workflow_source $ROOT_DIR/brew/functions.sh

# Git
go_sh_workflow_source $ROOT_DIR/git/functions.sh
go_sh_workflow_source $ROOT_DIR/git/aliases.sh

# Git Crypt
go_sh_workflow_source $ROOT_DIR/git-crypt/functions.sh

# rg
go_sh_workflow_source $ROOT_DIR/rg/aliases.sh

# ACK
go_sh_workflow_source $ROOT_DIR/ack/aliases.sh

# Java
go_sh_workflow_source $ROOT_DIR/java/aliases.sh
go_sh_workflow_source $ROOT_DIR/java/functions.sh

# VLC
go_sh_workflow_source $ROOT_DIR/vlc/functions.sh

# GPG
go_sh_workflow_source $ROOT_DIR/gpg/functions.sh

# OS utils
go_sh_workflow_source $ROOT_DIR/os_utils/functions.sh

# SSH
go_sh_workflow_source $ROOT_DIR/ssh/functions.sh

# Toggle (git-crypt encrypted - only loads in an unlocked checkout)
#go_sh_workflow_source $ROOT_DIR/toggl/functions.sh

# Tmux
go_sh_workflow_source $ROOT_DIR/tmux/aliases.sh

# Emacs
go_sh_workflow_source $ROOT_DIR/emacs/aliases.sh
go_sh_workflow_source $ROOT_DIR/emacs/functions.sh

# Utils
go_sh_workflow_source $ROOT_DIR/utils/functions.sh

# Nix
go_sh_workflow_source $ROOT_DIR/nix/functions.sh

# Cursor
go_sh_workflow_source $ROOT_DIR/cursor/env.sh
go_sh_workflow_source $ROOT_DIR/cursor/functions.sh

# AI agents (shared helpers use $GO_AI_AGENT, default claude)
go_sh_workflow_source $ROOT_DIR/claude/functions.sh
go_sh_workflow_source $ROOT_DIR/claude/aliases.sh
go_sh_workflow_source $ROOT_DIR/agy/functions.sh
go_sh_workflow_source $ROOT_DIR/agy/aliases.sh
go_sh_workflow_source $ROOT_DIR/gemini/functions.sh
go_sh_workflow_source $ROOT_DIR/ai/functions.sh
go_sh_workflow_source $ROOT_DIR/ai/aliases.sh

if (( ${#MISSING_SH_WORKFLOW_FILES} )); then
  print -u2 "my_sh_workflow: not sourced (run 'make link_tools'?): ${MISSING_SH_WORKFLOW_FILES[*]}"
fi

CUSTOM_BIN=$HOME/dotfiles/bin
export PATH=$CUSTOM_BIN:$PATH
